# Supabase browser configuration used by the static Birthly reset page.
# These values are public browser values and are injected at build time.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional static-site configuration.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_BIRTHLY_APP_STORE_URL=
NEXT_PUBLIC_BIRTHLY_GOOGLE_PLAY_URL=
NEXT_PUBLIC_BIRTHLY_IOS_URL=
NEXT_PUBLIC_BIRTHLY_ANDROID_URL=
